{
  "tasks": {
    "start": "deno run --allow-net --allow-read=. --allow-run ./.tasks/start.js"
  },
  // TODO: everything registers as a 'resource', even elements
  // e.g. - mysite.com/~elements/<tag-name>
  "compilerOptions": {
    "lib": [
      "deno.ns",
      "dom",
      "dom.iterable"
    ]
  },
  "imports": {
    "@onlyweb/backend": "jsr:@onlyweb/backend",
    "@onlyweb/shared": "jsr:@onlyweb/shared"
  }
}
