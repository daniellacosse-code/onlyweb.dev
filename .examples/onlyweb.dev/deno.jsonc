{
  "tasks": {
    "start": "deno run --allow-net --allow-env --allow-read=. --allow-run ./.tasks/start.js"
  },
  "compilerOptions": {
    "lib": [
      "deno.ns",
      "dom",
      "dom.iterable"
    ]
  }
  // we don't use an import map here so we can develop
  // against the latest onlyweb package code
}
