{
  "tasks": {
    "start": "OWF_WATCH=true deno run --watch --allow-net --allow-env --allow-read=. ./main.ts"
  },
  "compilerOptions": {
    "lib": [
      "deno.ns",
      "dom",
      "dom.iterable"
    ]
  }
  // we don't use an import map here so we can develop
  // against the latest onlyweb package code
}
